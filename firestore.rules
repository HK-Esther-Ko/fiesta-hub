rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Keep the bootstrap list identical to ADMIN_EMAILS in config.js.
//
// Levels (set by admins on the Access page; people can't change their own):
//   admin  → edits everything: calendar, roles, SOPs, analytics, links, access, and assigns requests
//   member → reads everything; edits only their own profile (name, photo, contact email, pixel character),
//            their own tasks, chat, and the working fields of calendar posts they own
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function bootstrapAdmin() { return signedIn() && email() in ['rhdptmej0102@gmail.com']; }
    function entry() { return get(/databases/$(database)/documents/allowed/$(email())).data; }
    function listed() { return signedIn() && exists(/databases/$(database)/documents/allowed/$(email())); }
    function isMember() { return bootstrapAdmin() || listed(); }
    function isAdmin() { return bootstrapAdmin() || (listed() && entry().get('access', 'member') == 'admin'); }
    function myTeam() { return listed() ? entry().get('teamId', '') : ''; }

    // default: everyone on the team reads, only admins write
    match /{coll}/{rest=**} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /allowed/{e} {
      allow read: if signedIn() && e == email();
    }
    // your own team card: name, photo, contact email and pixel character only
    match /team/{id} {
      allow update: if isMember() && id == myTeam()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'contactEmail', 'pixel']);
    }
    // calendar posts: the people a post belongs to (ownerIds) update its progress, brief, files link and post link
    match /content/{id} {
      allow update: if isMember() && myTeam() in resource.data.get('ownerIds', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'driveUrl', 'finalUrl', 'postUrl', 'postUrls', 'updatedAt']);
    }
    // tasks: anyone adds their own; the people on it work on it; admins assign (one or more people) and edit any
    function owners(d) { return d.get('ownerIds', [d.get('ownerId', '')]); }
    match /tasks/{id} {
      allow create: if isMember() && owners(request.resource.data) == [myTeam()];
      allow update: if isMember() && myTeam() in owners(resource.data) && owners(request.resource.data) == owners(resource.data);
      allow delete: if isMember() && owners(resource.data) == [myTeam()];
    }
    // media team meeting: anyone on the team can attach a meeting's notes doc link
    match /config/meetings {
      allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
    }
    // chat: anyone on the team can post and start group chats
    match /messages/{id} {
      allow create: if isMember() && request.resource.data.authorId == myTeam();
    }
    match /chats/{id} {
      allow create: if isMember();
      allow update: if isMember() && myTeam() in resource.data.members;
    }
  }
}
